{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jones.systems/prompt-generator/prompt-v1.json",
  "title": "Prompt Generator prompt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "prompt_id", "local_id", "revision", "workflow", "title", "outcome", "scope", "authority", "freshness", "dependencies", "ownership", "outputs", "verification", "continuity", "finish_line", "reporting", "lineage", "aliases", "intentional_gaps", "repository_bindings", "provenance"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "prompt"},
    "prompt_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}:[A-Za-z][A-Za-z0-9]*(?:[-_.][A-Za-z0-9]+)*$"},
    "local_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[-_.][A-Za-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "workflow": {"type": "string", "enum": ["research", "planning", "implementation", "verification", "review", "integration", "conflict-resolution", "correction", "resume", "migration", "handoff"]},
    "title": {"type": "string", "minLength": 1},
    "outcome": {"$ref": "#/$defs/outcome"},
    "scope": {"$ref": "#/$defs/scope"},
    "authority": {"$ref": "#/$defs/authority"},
    "freshness": {"$ref": "#/$defs/freshness"},
    "dependencies": {"$ref": "#/$defs/dependencies"},
    "ownership": {"$ref": "#/$defs/ownership"},
    "outputs": {"$ref": "#/$defs/outputs"},
    "verification": {"$ref": "#/$defs/verification"},
    "continuity": {"$ref": "#/$defs/continuity"},
    "finish_line": {"$ref": "#/$defs/finish_line"},
    "reporting": {"$ref": "#/$defs/reporting"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "aliases": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[-_.][A-Za-z0-9]+)*$"}, "uniqueItems": true},
    "intentional_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}, "uniqueItems": true},
    "repository_bindings": {"type": "array", "items": {"$ref": "#/$defs/repository_binding"}, "uniqueItems": true},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "text_list": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "prompt_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}:[A-Za-z][A-Za-z0-9]*(?:[-_.][A-Za-z0-9]+)*$"},
    "outcome": {"type": "object", "additionalProperties": false, "required": ["summary", "success_criteria"], "properties": {"summary": {"$ref": "#/$defs/text"}, "success_criteria": {"$ref": "#/$defs/text_list", "minItems": 1}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["included", "excluded"], "properties": {"included": {"$ref": "#/$defs/text_list"}, "excluded": {"$ref": "#/$defs/text_list"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["required", "forbidden"], "properties": {"required": {"$ref": "#/$defs/text_list"}, "forbidden": {"$ref": "#/$defs/text_list"}}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["source_revision", "checked_at"], "properties": {"source_revision": {"$ref": "#/$defs/text"}, "checked_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}}},
    "dependencies": {"type": "object", "additionalProperties": false, "required": ["requires", "gates"], "properties": {"requires": {"$ref": "#/$defs/text_list"}, "gates": {"$ref": "#/$defs/text_list"}}},
    "ownership": {"type": "object", "additionalProperties": false, "required": ["accountable", "writer_scope"], "properties": {"accountable": {"$ref": "#/$defs/text"}, "writer_scope": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1}, "reviewers": {"$ref": "#/$defs/text_list"}}},
    "outputs": {"type": "object", "additionalProperties": false, "required": ["artifacts", "formats"], "properties": {"artifacts": {"$ref": "#/$defs/text_list"}, "formats": {"$ref": "#/$defs/text_list"}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["checks"], "properties": {"checks": {"$ref": "#/$defs/text_list"}, "evidence": {"$ref": "#/$defs/text_list"}}},
    "continuity": {"type": "object", "additionalProperties": false, "required": ["checkpoint", "recovery"], "properties": {"checkpoint": {"$ref": "#/$defs/text"}, "recovery": {"$ref": "#/$defs/text"}, "invalidation": {"$ref": "#/$defs/text"}}},
    "finish_line": {"type": "object", "additionalProperties": false, "required": ["criteria", "owner"], "properties": {"criteria": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1}, "owner": {"$ref": "#/$defs/text"}}},
    "reporting": {"type": "object", "additionalProperties": false, "required": ["fields"], "properties": {"fields": {"$ref": "#/$defs/text_list"}, "channel": {"$ref": "#/$defs/text"}}},
    "lineage": {"type": "object", "additionalProperties": false, "properties": {"supersedes": {"type": "array", "items": {"$ref": "#/$defs/prompt_id"}}, "corrects": {"type": "array", "items": {"$ref": "#/$defs/prompt_id"}}, "derived_from": {"type": "array", "items": {"$ref": "#/$defs/prompt_id"}}, "reason": {"$ref": "#/$defs/text"}}},
    "gap": {"type": "object", "additionalProperties": false, "required": ["gap_id", "reason"], "properties": {"gap_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[-_.][A-Za-z0-9]+)*$"}, "reason": {"$ref": "#/$defs/text"}, "owner": {"$ref": "#/$defs/text"}}},
    "repository_binding": {"type": "object", "additionalProperties": false, "required": ["binding_id", "repository", "branch", "delivery"], "properties": {"binding_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[-_.][A-Za-z0-9]+)*$"}, "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "root": {"$ref": "#/$defs/text"}, "branch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"}, "base": {"$ref": "#/$defs/text"}, "head": {"$ref": "#/$defs/text"}, "delivery": {"type": "string", "enum": ["task-branch", "draft-pr", "local"]}, "workspace": {"$ref": "#/$defs/text"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source", "source_revision", "imported"], "properties": {"source": {"$ref": "#/$defs/text"}, "source_revision": {"$ref": "#/$defs/text"}, "imported": {"type": "boolean"}, "license": {"$ref": "#/$defs/text"}, "notes": {"$ref": "#/$defs/text"}}}
  }
}
